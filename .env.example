# Copy to `.env` and fill in. `.env` is git-ignored; this template is committed.

# --- LiveKit (values printed by `livekit-server --dev`) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Providers (fill these in) ---
DEEPGRAM_API_KEY=your_deepgram_key_here
OPENAI_API_KEY=your_openai_key_here
# Note the name: the LiveKit ElevenLabs plugin reads ELEVEN_API_KEY, not ELEVENLABS_API_KEY.
ELEVEN_API_KEY=your_elevenlabs_key_here

# --- Optional: confidence policy -----------------------------------------------------
# Band boundaries. HIGH is inclusive, LOW is exclusive:
#   low = [0, LOW_CONFIDENCE)   medium = [LOW, HIGH)   high = [HIGH_CONFIDENCE, 1]
# HIGH_CONFIDENCE=0.8
# LOW_CONFIDENCE=0.6

# What happens on a low-confidence turn.
#   deterministic (default) - speak CLARIFICATION_PROMPT and skip the LLM entirely
#   llm                     - annotate the context and let the model phrase it
# LOW_CONFIDENCE_STRATEGY=deterministic

# CLARIFICATION_PROMPT=Sorry, I may have misunderstood you. Could you please repeat that?

# --- Optional: reproducible demos ----------------------------------------------------
# Overrides Deepgram's real confidence on EVERY turn with a simulated value. The agent
# logs a warning at startup and tags each turn `source=forced` so a simulated run can
# never be mistaken for a real measurement. Must be a number in [0.0, 1.0] or the worker
# refuses to start. Leave commented out for real transcription.
# FORCE_CONFIDENCE=0.35
